# ============================================================
# 环境变量示例文件
# 用法：复制本文件为 .env，再把下面的值改成自己本机的配置。
# 注意：.env 已被 .gitignore 忽略，绝不要把真实口令提交到仓库。
# ============================================================

# Flask 会话与 CSRF 签名密钥。
# 开发环境可随便填一串足够长的随机字符；生产环境必须重新生成，
# 可用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成。
SECRET_KEY=请替换成你自己的随机密钥

# 数据库连接串，格式：mysql+pymysql://用户名:口令@主机:端口/库名?charset=utf8mb4
# 请把 用户名 / 口令 换成本机 MySQL 的真实账号，库名保持 sk3017_ledger。
DATABASE_URL=mysql+pymysql://root:你的数据库口令@127.0.0.1:3306/sk3017_ledger?charset=utf8mb4

# 可选：Flask 运行配置（不填则使用代码默认值 development / 127.0.0.1:5001）。
# FLASK_ENV=development
# FLASK_RUN_PORT=5001
